provider "aws" {
  region = "eu-west-2"
}

data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"]
  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }
}

resource "aws_security_group" "bot_sg" {
  name        = "trading_bot_firewall_v3"
  description = "Allow SSH and Outbound Traffic"

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "fintech_bot_server" {
  ami           = data.aws_ami.ubuntu.id
  instance_type = "t3.micro"
  
  vpc_security_group_ids = [aws_security_group.bot_sg.id]

  # THE MAGIC: Zero-Touch Provisioning Script
  user_data = <<-EOF
              #!/bin/bash
              # 1. Update OS and Install Docker & Git
              sudo apt-get update -y
              sudo apt-get install -y docker.io git docker-compose-v2
              sudo systemctl start docker
              sudo systemctl enable docker
              sudo usermod -aG docker ubuntu
              
              # 2. Clone your Portfolio from GitHub
              cd /home/ubuntu
              git clone https://github.com/s1na47/Fintech-Lab.git
              
              # 3. Launch the Bitcoin Database Pipeline
              cd Fintech-Lab/05_data_pipeline
              sudo docker compose up --build -d
              EOF

  tags = {
    Name = "Fintech-Zero-Touch-Server"
  }
}

output "server_public_ip" {
  value = aws_instance.fintech_bot_server.public_ip
}